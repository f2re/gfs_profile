# Telegram Bot API token from @BotFather.
TELEGRAM_BOT_TOKEN=

# Telegram administrator ids. Comma/space separated numeric Telegram user ids.
TELEGRAM_ADMIN_IDS=
TELEGRAM_ADMIN_DB=.cache_gfs/admin_stats.sqlite3

# Persistent per-user active points and successful product parameters.
# The file stays under .cache_gfs and survives the normal deploy procedure.
TELEGRAM_PREFERENCES_DB=.cache_gfs/telegram_preferences.sqlite3

# Multi-messenger runtime. Keep disabled until HTTPS reverse proxy and platform
# credentials are configured. With 0 the launcher preserves legacy Telegram polling.
MESSENGER_RUNTIME_ENABLED=0
MESSENGER_RUNTIME_HOST=127.0.0.1
MESSENGER_RUNTIME_PORT=8081
MESSENGER_RUNTIME_LOG_LEVEL=info
MESSENGER_RUNTIME_ACCESS_LOG=0

# MAX Bot API. Production uses Webhook on a public HTTPS:443 endpoint, usually
# reverse-proxied to MESSENGER_RUNTIME_HOST:MESSENGER_RUNTIME_PORT/webhooks/max.
MAX_BOT_TOKEN=
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=

# VK Community Bot + Callback API. VK_CONFIRMATION_CODE is the code returned by
# groups.getCallbackConfirmationCode for VK_GROUP_ID.
VK_BOT_TOKEN=
VK_GROUP_ID=
VK_CALLBACK_URL=
VK_CALLBACK_SECRET=
VK_CONFIRMATION_CODE=
VK_API_VERSION=5.199

# Geocoding. DaData is primary; local dictionary and Nominatim are fallbacks.
# DaData Suggestions requires only API key (token), not Secret Key.
GEOCODER_PROVIDERS=dadata,local,nominatim
DADATA_API_KEY=
DADATA_SUGGEST_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs/suggest/address
DADATA_TIMEOUT=12
GEOCODER_USER_AGENT=gfs-profile-telegram-bot/0.1
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODE_CACHE_DIR=.cache_gfs/geocode
GEOCODE_CACHE_TTL_SECONDS=2592000
GEOCODE_TIMEOUT=12

# Runtime knobs.
DEFAULT_LEAD=24
MAX_CONCURRENT_GFS=2
MAX_CONCURRENT_GEOCODE=2
MAX_CONCURRENT_METEOGRAM=2
GFS_CACHE_DIR=.cache_gfs
GFS_CACHE_TTL_SECONDS=86400
GFS_AVAILABILITY_CACHE_TTL_SECONDS=300
GFS_REQUEST_TIMEOUT=35

# /meteogram point forecasts and ensembles delivered by Open-Meteo.
# Cache is stored under GFS_CACHE_DIR/meteogram and is preserved by deploy.
METEOGRAM_CACHE_TTL=10800
METEOGRAM_HTTP_TIMEOUT=90
METEOGRAM_HTTP_RETRIES=3
METEOGRAM_DPI=170

# Pressure-level subset for NOMADS GRIB Filter.
# Empty/all/full = all levels. profile/default = operational profile levels.
GFS_PRESSURE_LEVELS_HPA=

# /map animation. mode=gif uses silent H.264/MP4 if ffmpeg is installed.
MAP_ANIMATION_PIXEL_SIZE=1280
MAP_ANIMATION_FRAME_DURATION_MS=650
MAP_ANIMATION_OUTPUT_FPS=8
MAP_ANIMATION_CRF=20

# DOCX/PDF reports from /meteogram. PDF is rendered natively by Matplotlib.
# LIBREOFFICE_BIN/METEOGRAM_PDF_TIMEOUT are optional only for the secondary fallback converter.
LIBREOFFICE_BIN=
METEOGRAM_PDF_TIMEOUT=90
METEOGRAM_REPORT_FONT=Liberation Sans

# Автоматическая отправка продукции по расписанию (не более 2 на пользователя).
TELEGRAM_SCHEDULE_FILE=.cache_gfs/telegram_schedules.json
TELEGRAM_SCHEDULE_POLL_SECONDS=30
TELEGRAM_SCHEDULE_MAX_LATE_MINUTES=180
TELEGRAM_SCHEDULE_TIMEZONE_TIMEOUT=10
MAX_CONCURRENT_SCHEDULED=1
