# Per-platform switches. auto = enable only when the platform token is present.
TELEGRAM_ENABLED=auto
MAX_ENABLED=auto
VK_ENABLED=auto

TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_IDS=
TELEGRAM_ADMIN_DB=.cache_gfs/admin_stats.sqlite3
TELEGRAM_PREFERENCES_DB=.cache_gfs/telegram_preferences.sqlite3
MESSENGER_PREFERENCES_DB=.cache_gfs/messenger_preferences.sqlite3

MESSENGER_RUNTIME_ENABLED=1
MESSENGER_RUNTIME_HOST=127.0.0.1
MESSENGER_RUNTIME_PORT=8081
MESSENGER_RUNTIME_LOG_LEVEL=info
MESSENGER_RUNTIME_ACCESS_LOG=0

MAX_BOT_TOKEN=
MAX_WEBHOOK_URL=
MAX_WEBHOOK_SECRET=

VK_BOT_TOKEN=
VK_GROUP_ID=
VK_CALLBACK_URL=
VK_CALLBACK_SECRET=
VK_CONFIRMATION_CODE=
VK_API_VERSION=5.199

GEOCODER_PROVIDERS=dadata,local,nominatim
DADATA_API_KEY=
DADATA_SUGGEST_URL=https://suggestions.dadata.ru/suggestions/api/4_1/rs/suggest/address
DADATA_TIMEOUT=12
GEOCODER_USER_AGENT=gfs-profile-telegram-bot/0.1
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GEOCODE_CACHE_DIR=.cache_gfs/geocode
GEOCODE_CACHE_TTL_SECONDS=2592000
GEOCODE_TIMEOUT=12

# Process-wide limits shared by Telegram, MAX, VK and web/API.
DEFAULT_LEAD=24
MAX_CONCURRENT_GFS=2
MAX_CONCURRENT_GEOCODE=2
MAX_CONCURRENT_METEOGRAM=2
MAX_CONCURRENT_WEATHERNEXT3=2
GFS_CACHE_DIR=.cache_gfs
GFS_CACHE_TTL_SECONDS=86400
GFS_AVAILABILITY_CACHE_TTL_SECONDS=300
GFS_REQUEST_TIMEOUT=35

METEOGRAM_CACHE_TTL=10800
METEOGRAM_HTTP_TIMEOUT=90
METEOGRAM_HTTP_RETRIES=3
METEOGRAM_DPI=170

GFS_PRESSURE_LEVELS_HPA=

MAP_ANIMATION_PIXEL_SIZE=1280
MAP_ANIMATION_FRAME_DURATION_MS=650
MAP_ANIMATION_OUTPUT_FPS=8
MAP_ANIMATION_CRF=20

# WeatherNext is entirely disabled by default (menus, providers, API, schedules).
# Explicit opt-in requires optional dependencies and Google access; restart afterwards.
WEATHERNEXT3_ENABLED=0

# WeatherNext 3 BigQuery Analytics Hub linked dataset.
# Requires Google Application Default Credentials (ADC). Never commit service-account JSON.
WEATHERNEXT3_BIGQUERY_PROJECT=
WEATHERNEXT3_BIGQUERY_DATASET=
WEATHERNEXT3_BIGQUERY_BILLING_PROJECT=
WEATHERNEXT3_BIGQUERY_LOCATION=
# Per QUERY ceiling, not a daily budget. 0 explicitly disables the cap.
WEATHERNEXT3_BQ_MAX_BYTES_BILLED=1000000000
WEATHERNEXT3_BIGQUERY_TIMEOUT=180
WEATHERNEXT3_CACHE_TTL=1800
WEATHERNEXT3_MAP_PIXEL_SIZE=1280
WEATHERNEXT3_MAP_FRAME_DURATION_MS=700
WEATHERNEXT3_MAP_FPS=8
WEATHERNEXT3_PRECIP_VMAX_MM=30
# Optional path to local protected service-account credentials. Prefer workload identity/ADC where available.
GOOGLE_APPLICATION_CREDENTIALS=
# Raw upper-air data. Requires allowlisted ADC and Requester Pays billing project.
WEATHERNEXT3_GCS_BILLING_PROJECT=
WEATHERNEXT3_ZARR_MAX_SUBSET_BYTES=33554432
WEATHERNEXT3_ZARR_MAX_CHUNK_BYTES=134217728
WEATHERNEXT3_ZARR_MAX_READ_BYTES=536870912
# Optional authenticated API; empty = off. Never put a real key in this example.
WEATHERNEXT3_API_KEY=

LIBREOFFICE_BIN=
METEOGRAM_PDF_TIMEOUT=90
METEOGRAM_REPORT_FONT=Liberation Sans

MESSENGER_SCHEDULE_POLL_SECONDS=30
MESSENGER_SCHEDULE_MAX_LATE_MINUTES=180
MESSENGER_SCHEDULE_TIMEZONE_TIMEOUT=10

TELEGRAM_SCHEDULE_FILE=.cache_gfs/telegram_schedules.json
TELEGRAM_SCHEDULE_POLL_SECONDS=30
TELEGRAM_SCHEDULE_MAX_LATE_MINUTES=180
TELEGRAM_SCHEDULE_TIMEZONE_TIMEOUT=10
MAX_CONCURRENT_SCHEDULED=1
